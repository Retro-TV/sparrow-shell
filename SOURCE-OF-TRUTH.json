    {"source": "gtk/Sparrow/index.theme", "destination": "$XDG_DATA_HOME/themes/Sparrow/index.theme", "category": "A", "dependencies": ["gtk3", "adw-gtk-theme"], "generation": null},
    {"source": "icons/Sparrow", "destination": "$XDG_DATA_HOME/icons/Sparrow", "category": "A", "dependencies": ["GTK icon theme support"], "generation": "copy tracked icon subset; generated SVGs and cache are separate B outputs"},
