    {"source": "hyprlock/hyprlock.conf", "destination": "$XDG_CONFIG_HOME/sparrow/hyprlock.conf", "category": "A", "dependencies": ["hyprlock (fallback only)"], "generation": null},
    {"source": "quickshell/sparrow", "destination": "$XDG_CONFIG_HOME/quickshell/sparrow", "category": "A", "dependencies": ["quickshell", "inter-font", "adwaita-fonts", "bundled Outfit Black", "python-pillow", "matugen", "awww"], "generation": "deploy complete tracked runtime tree at a stable XDG location; never point a deployed unit at the development checkout"},
    {"source": "quickshell/sparrow/systemd/sparrow-shell.service", "destination": "$XDG_CONFIG_HOME/systemd/user/sparrow-shell.service", "category": "A", "dependencies": ["systemd user", "niri-session", "quickshell"], "generation": null},
    {"source": "quickshell/sparrow/systemd/sparrow-idle.service", "destination": "$XDG_CONFIG_HOME/systemd/user/sparrow-idle.service", "category": "A", "dependencies": ["systemd user", "niri-session", "quickshell"], "generation": null},
    {"source": "quickshell/sparrow/systemd/sparrow-wallpaper.service", "destination": "$XDG_CONFIG_HOME/systemd/user/sparrow-wallpaper.service", "category": "A", "dependencies": ["systemd user", "awww", "matugen", "python-pillow", "adw-gtk-theme"], "generation": null},
    {"source": "quickshell/sparrow/systemd/sparrow-polkit-agent.service", "destination": "$XDG_CONFIG_HOME/systemd/user/sparrow-polkit-agent.service", "category": "A", "dependencies": ["lxqt-policykit", "systemd user"], "generation": "deploy/enable only when no other graphical Polkit agent is selected"},
    {"source": "quickshell/sparrow/systemd/xdg-desktop-portal-gtk.service.d/10-sparrow-theme.conf", "destination": "$XDG_CONFIG_HOME/systemd/user/xdg-desktop-portal-gtk.service.d/10-sparrow-theme.conf", "category": "A", "dependencies": ["xdg-desktop-portal-gtk", "Sparrow GTK theme"], "generation": null},
    {"source": "niri/defaults/user-input.kdl", "destination": "$XDG_CONFIG_HOME/niri/sparrow/user-input.kdl", "category": "D", "dependencies": ["niri>=26.04"], "generation": "FUTURE INSTALLER: copy seed only when destination is absent, before first Niri start; never overwrite later Input UI choices"},
    {"source": "quickshell/sparrow/wallpapers/default.png + quickshell/sparrow/scripts/wallcolors.py", "destination": "$XDG_CACHE_HOME/sparrow-shell/palette.json", "category": "B", "dependencies": ["matugen", "python-pillow", "default.png"], "generation": "wallcolors.py default.png --style auto --mode auto --source-mode dynamic"},
    {"source": "quickshell/sparrow/scripts/wallcolors.py + palette.json", "destination": "$XDG_CONFIG_HOME/niri/sparrow/generated-colors.kdl", "category": "B", "dependencies": ["niri>=26.04"], "generation": "wallcolors.py through niri-config-transaction.py; validate before reload"},
    {"source": "quickshell/sparrow/scripts/wallcolors.py + palette.json", "destination": "$XDG_CONFIG_HOME/kitty/sparrow-colors.conf", "category": "B", "dependencies": ["kitty"], "generation": "wallcolors.py writes Matugen-derived terminal roles"},
    {"source": "quickshell/sparrow/scripts/wallcolors.py + palette.json + installed adw-gtk-theme", "destination": "$XDG_DATA_HOME/themes/Sparrow/gtk-3.0/{gtk.css,gtk-dark.css}", "category": "B", "dependencies": ["adw-gtk-theme", "python-pillow", "matugen"], "generation": "wallcolors.py recolors the complete system adw-gtk3 GTK3 source CSS; missing source is fatal"},
    {"source": "quickshell/sparrow/scripts/wallcolors.py + palette.json + installed adw-gtk-theme", "destination": "$XDG_DATA_HOME/themes/Sparrow/gtk-4.0/{gtk.css,gtk-dark.css,libadwaita.css,libadwaita-tweaks.css,assets/**}", "category": "B", "dependencies": ["adw-gtk-theme", "python-pillow", "matugen"], "generation": "wallcolors.py copies the system GTK4 base/assets and recolors libadwaita roles; missing source is fatal"},
    {"source": "quickshell/sparrow/scripts/wallcolors.py + palette.json + icons/Sparrow", "destination": "$XDG_DATA_HOME/icons/Sparrow/{scalable/places/**,symbolic/places/folder-symbolic.svg,scalable/mimetypes/text-x-generic.svg,icon-theme.cache}", "category": "B", "dependencies": ["matugen", "gtk-update-icon-cache for cache refresh"], "generation": "wallcolors.py renders colored SVGs; icon cache refresh is optional"},
    {"source": "niri/sparrow/cursor.kdl + environment.d/90-cursor.conf", "destination": "GSettings org.gnome.desktop.interface cursor-theme/ cursor-size", "category": "B", "dependencies": ["Bibata-Modern-Ice installed", "gsettings"], "generation": "FUTURE INSTALLER: set Bibata-Modern-Ice and 24 only with user consent; preserve an existing cursor choice"},
    {"source": "fonts.gtk", "destination": "GSettings org.gnome.desktop.interface font-name", "category": "D", "dependencies": ["adwaita-fonts", "gsettings"], "generation": "FUTURE INSTALLER: offer Adwaita Sans 11 as the canonical GTK setting; preserve an existing user font choice"},
    {"source": "target Niri output inventory", "destination": "$XDG_CONFIG_HOME/niri/sparrow/{display-outputs.kdl,display-binds.kdl}", "category": "C", "dependencies": ["niri>=26.04"], "generation": "Display UI derives output names, modes, arrangement, numbering and focus for this machine"},
    {"source": "target backlight/DDC devices", "destination": "Sparrow Mixer brightness controls", "category": "C", "dependencies": ["brightnessctl when internal backlight exists", "ddcutil when external DDC monitors exist"], "generation": "runtime hardware discovery; never copy reference SSD hardware state"},
    {"source": "Sparrow UI/user actions", "destination": "$XDG_CONFIG_HOME/niri/sparrow/{user-appearance.kdl,user-binds.kdl,user-input.kdl}", "category": "D", "dependencies": ["niri>=26.04"], "generation": "managed transactions after user changes; preserve existing fragments"},
    {"source": "Sparrow wallpaper picker and user media", "destination": "$XDG_STATE_HOME/sparrow-shell/{wallpaper,wallpaper-map,wallpaper-bag,flags.json}", "category": "D", "dependencies": ["awww", "optional mpvpaper"], "generation": "fresh state selects bundled default.png; never copy personal selection or collection"},
    {"source": "Sparrow runtime", "destination": "$XDG_STATE_HOME/sparrow-shell/** and $XDG_CACHE_HOME/sparrow-shell/** except generated palette.json", "category": "D", "dependencies": [], "generation": "runtime histories, logs, thumbnails and transaction backups; never deploy"}
  ]
}
