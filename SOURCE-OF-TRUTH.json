{
  "schema": 1,
  "classification": {
    "A": "tracked portable source; deploy exact bytes unless conditional",
    "B": "generated from tracked inputs and declared system dependencies",
    "C": "machine-specific; discover or configure on the target machine",
    "D": "mutable user choice or runtime history; preserve, never copy from the reference SSD"
  },
  "cursor": {
    "theme": "Bibata-Modern-Ice",
    "size": 24,
    "upstream": "https://github.com/ful1e5/Bibata_Cursor/releases/tag/v2.0.6",
    "asset": "Bibata-Modern-Ice.tar.xz",
    "license": "GPL-3.0",
    "arch_source": "AUR bibata-cursor-theme-bin (manual/reviewed; package version may differ from SSD v2.0.6)",
    "gsettings": {
      "schema": "org.gnome.desktop.interface",
      "cursor-theme": "Bibata-Modern-Ice",
      "cursor-size": 24
    }
  },
  "fonts": {
    "quickshell": {"family": "Inter Black", "package": "inter-font", "source": "quickshell/sparrow/Singletons/Theme.qml"},
    "terminal": {"family": "JetBrains Mono Nerd Font", "package": "ttf-jetbrains-mono-nerd", "source": "kitty/kitty.conf"},
    "gtk": {"family": "Adwaita Sans 11", "package": "adwaita-fonts", "setting": "GSettings org.gnome.desktop.interface font-name"},
    "lockscreen": {"family": "Outfit Black", "source": "quickshell/sparrow/Lockscreen/font/Outfit-Black.ttf", "license": "OFL-1.1"}
  },
  "entries": [
