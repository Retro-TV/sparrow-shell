    {"source": "niri/sparrow/cursor.kdl", "destination": "$XDG_CONFIG_HOME/niri/sparrow/cursor.kdl", "category": "A", "dependencies": ["Bibata-Modern-Ice installed"], "generation": "deploy only when the named cursor theme exists"},
    {"source": "environment.d/90-cursor.conf", "destination": "$XDG_CONFIG_HOME/environment.d/90-cursor.conf", "category": "A", "dependencies": ["Bibata-Modern-Ice installed", "systemd user environment"], "generation": "deploy only when the named cursor theme exists"},
    {"source": "kitty/kitty.conf", "destination": "$XDG_CONFIG_HOME/kitty/kitty.conf", "category": "A", "dependencies": ["kitty", "ttf-jetbrains-mono-nerd"], "generation": null},
