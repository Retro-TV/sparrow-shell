{
  "bootstrap": {
    "before_clone": ["git"],
    "installer_runtime": ["python"],
    "python_missing_prompt": "sudo pacman -S --needed python"
  },
  "required": [
    "niri",
    "quickshell",
    "python",
    "python-pillow",
    "python-gobject",
    "bash",
    "jq",
    "matugen",
    "awww",
    "gtk3",
    "adw-gtk-theme",
    "adwaita-fonts",
    "fontconfig",
    "inter-font",
    "kitty",
    "fish",
    "starship",
    "greetd",
    "greetd-tuigreet",
    "ttf-jetbrains-mono-nerd",
    "thunar",
    "xdg-desktop-portal",
    "xdg-desktop-portal-gtk",
    "xdg-desktop-portal-gnome",
    "qt6-5compat",
    "qt6-multimedia",
    "qt6-multimedia-ffmpeg",
    "pipewire",
    "wireplumber",
    "pipewire-pulse",
    "coreutils",
    "findutils",
    "grep",
    "gawk",
    "sed",
    "procps-ng",
    "util-linux",
    "iproute2"
  ],
  "defaults": [
    "curl",
    "wl-clipboard",
    "ffmpeg",
    "tumbler",
    "gvfs",
    "udisks2",
    "firefox",
    "pavucontrol",
    "xdg-utils",
    "libnotify"
  ],
  "required_executables": ["niri", "qs", "python3", "bash", "jq", "matugen", "awww", "awww-daemon", "mpvpaper", "wpctl", "gtk-launch", "kitty", "fish", "starship", "greetd", "tuigreet", "thunar", "fc-match"],
  "required_feature_packages": ["mpvpaper"],
  "platform_executables": ["systemctl", "systemd-analyze", "env", "gio", "udevadm", "ps"],
  "required_python_modules": ["PIL.Image", "gi"],
  "polkit_agent": {"package": "lxqt-policykit", "executable": "lxqt-policykit-agent"},
  "optional": {
    "recording": ["gpu-screen-recorder", "slurp"],
    "network-bluetooth-battery": ["networkmanager", "bluez", "bluez-utils", "upower"],
    "night-light": ["wlsunset"],
    "audio-visualizer": ["cava"],
    "brightness-hardware": ["brightnessctl", "ddcutil"],
    "wallpaper-search": ["imagemagick"],
    "hyprlock-fallback": ["hyprlock"]
  },
  "manual_external": {
    "Rishot screenshot app (separate upstream project)": "rishot-git"
  },
  "manual_optional": {
    "NVIDIA vibrance": "nvibrant has no Sparrow-selected official Arch package; source/package is user and driver specific.",
    "Rishot": "Install using its upstream-supported method; Sparrow does not clone or run a remote installer."
  }
}
