// Sparrow's portable Niri entry point.
// Install as ~/.config/niri/config.kdl only after preserving/merging any
// existing user configuration. Generated and user-managed fragments stay out
// of the repository and are included only when present.

// A single entry include lets the installer integrate Sparrow into an
// existing user-owned config without replacing that file. Includes inside
// sparrow/entry.kdl are relative to this managed fragment.
include "sparrow/entry.kdl"

// Fresh-install defaults only. When merging into an existing config, keep the
// user's own cursor and miscellaneous Niri preferences instead.
include "sparrow/session-defaults.kdl"
include "sparrow/cursor.kdl"
