// Sparrow Shell Niri foundation.
// The active configuration stays here; Sparrow-controlled pieces live in sparrow/.

include "sparrow/appearance.kdl"
include optional=true "sparrow/generated-colors.kdl"
include optional=true "sparrow/display-outputs.kdl"
include "sparrow/window-rules.kdl"
include "sparrow/binds.kdl"
include optional=true "sparrow/user-binds.kdl"
include optional=true "sparrow/display-binds.kdl"
include "sparrow/input.kdl"

include optional=true "sparrow/cursor.kdl"

hotkey-overlay {
    skip-at-startup
}

// Ask clients to omit client-side decorations where possible so Niri's geometry is visible.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Keep Niri's scrolling-layout animations at their defaults.
}
