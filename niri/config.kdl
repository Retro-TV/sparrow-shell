// Sparrow's portable Niri entry point.
// Install as ~/.config/niri/config.kdl only after preserving/merging any
// existing user configuration. Generated and user-managed fragments stay out
// of the repository and are included only when present.

include "sparrow/appearance.kdl"
// Wallpaper-generated colors intentionally come after appearance defaults.
include optional=true "sparrow/generated-colors.kdl"
include optional=true "sparrow/display-outputs.kdl"
include "sparrow/window-rules.kdl"
include "sparrow/binds.kdl"
include optional=true "sparrow/user-binds.kdl"
include optional=true "sparrow/display-binds.kdl"
include "sparrow/input.kdl"

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

// Prefer Niri's geometry over client-side decorations where clients permit.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Keep Niri's native scrolling-layout animation defaults.
