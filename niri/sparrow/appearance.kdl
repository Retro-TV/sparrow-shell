// Sparrow's portable Niri-native layout and appearance defaults.

layout {
    // Let the backdrop wallpaper show through the scaled workspace in Overview.
    background-color "transparent"

    // Disable Niri's transient window-drag insertion preview to match Sparrow's surfaces.
    insert-hint {
        off
    }

    // One Niri gap supplies inner and outer window spacing on every display.
    // Sparrow's Pill reserves its own body space without replacing this gap.
    gaps 8
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    center-focused-column "never"
    // Keep a lone default-width column visually balanced without changing
    // Niri's normal scrolling layout once a second column exists.
    always-center-single-column true

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#e0563b"
        inactive-color "#313a4d"
        urgent-color "#e0563b"
    }

    shadow {
        on
        softness 12
        spread 0
        offset x=0 y=0
        color "#14110faa"
    }
}

// Keep wallpaper stationary in Overview instead of scaling it with workspaces.
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

overview {
    // Niri's default zoom is already 0.5; retain it and remove the workspace card shadow.
    workspace-shadow {
        off
    }
}

// Keep Niri's native Alt-Tab switcher, with a restrained Sparrow-shaped focus.
// Wallpaper-derived Matugen colors override the fallback colors below.
recent-windows {
    highlight {
        active-color "#e0563b"
        urgent-color "#e0563b"
        padding 6
        corner-radius 12
    }
}

// User values changed through Sparrow Look override these portable defaults.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Product motion default; Look-generated preferences override this when saved.
animations {
    slowdown 1.5
}

include optional=true "user-appearance.kdl"
