// Portable Niri-native layout and appearance defaults for Sparrow.

layout {
    // Keep wallpaper stationary behind workspaces in Overview.
    background-color "transparent"

    gaps 6
    struts {
        left 12
        right 12
        bottom 12
    }

    center-focused-column "never"
    // Keep a lone default-width column visually balanced without changing
    // Niri's normal scrolling layout once a second column exists.
    always-center-single-column true

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#e0563b"
        inactive-color "#313a4d"
        urgent-color "#e0563b"
    }

    shadow {
        on
        softness 12
        spread 0
        offset x=0 y=0
        color "#14110faa"
    }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

// Keep Niri's native Alt-Tab switcher, with a restrained Sparrow-shaped focus.
// Wallpaper-derived Matugen colors override the fallback colors below.
recent-windows {
    highlight {
        active-color "#e0563b"
        urgent-color "#e0563b"
        padding 8
        corner-radius 12
    }
}

// Sparrow Look writes user overrides here; never track that generated file.
include optional=true "user-appearance.kdl"
