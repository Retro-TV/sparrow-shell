// Portable Sparrow Niri integration. This file is included by config.kdl or
// by a managed include block in an existing user-owned Niri config.
include "appearance.kdl"
// Wallpaper-generated colors intentionally come after appearance defaults.
include optional=true "generated-colors.kdl"
include optional=true "display-outputs.kdl"
include "window-rules.kdl"
include "binds.kdl"
include optional=true "user-binds.kdl"
include optional=true "display-binds.kdl"
include "input.kdl"
