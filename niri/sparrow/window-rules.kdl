// Keep Firefox picture-in-picture windows detached from the tiled layout.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Preserve the initial-width workaround for WezTerm.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
