// Preserve the existing Firefox picture-in-picture behavior.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Preserve the WezTerm initial configure workaround.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Polkit prompts are transient system dialogs, not tiled application windows.
// Let the agent request its own natural size; Niri centers floating windows by default.
window-rule {
    match app-id=r#"^lxqt-policykit-agent$"#
    open-floating true
}
