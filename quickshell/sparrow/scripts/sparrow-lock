#!/usr/bin/env bash
set -euo pipefail

operation="${1:-lock}"
case "$operation" in
    lock) method="lock" ;;
    power-off) method="powerOff" ;;
    suspend) method="suspend" ;;
    *) printf 'sparrow-lock: unknown operation: %s\n' "$operation" >&2; exit 2 ;;
esac

lock_config="${HOME}/Projects/sparrow-shell/quickshell/sparrow/lock/shell.qml"
systemctl --user import-environment WAYLAND_DISPLAY NIRI_SOCKET
systemctl --user start sparrow-lock.service

for attempt in {1..30}; do
    if qs ipc --path "$lock_config" call lock "$method" >/dev/null 2>&1; then
        exit 0
    fi
    sleep 0.1
done

logger -t sparrow-lock "Quickshell lock IPC did not become available for operation ${operation}"
printf 'sparrow-lock: secure lock process did not become available\n' >&2
exit 1
