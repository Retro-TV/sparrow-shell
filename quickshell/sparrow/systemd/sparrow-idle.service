[Unit]
Description=Sparrow idle policy monitor
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 %h/.config/quickshell/sparrow/scripts/migrate-state.py
ExecStart=/usr/bin/qs --no-duplicate --path %h/.config/quickshell/sparrow/idle/shell.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
