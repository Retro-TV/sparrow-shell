[Unit]
Description=Sparrow Quickshell desktop shell
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
Type=simple
ExecStart=/usr/bin/qs --no-duplicate --path %h/.config/quickshell/sparrow
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
