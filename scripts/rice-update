#!/usr/bin/env bash
set -euo pipefail

ROOT=""
DRY_RUN=0
PUSH=1
MESSAGE=""

usage() {
    cat <<'EOF'
Usage: rice-update [options]

Snapshots the supported rice configuration, package manifests, defaults, and
user services; checks for obvious secrets; commits changes; and pushes them.

  --repo PATH       Repository location (otherwise detect it)
  --dry-run         Snapshot and show changes without committing or pushing
  --no-push         Commit locally but do not push
  -m, --message     Commit message
  -h, --help        Show help

Only the allowlisted dotfiles and system facts are captured. Browser profiles,
account data, caches, credentials, wallpapers, and arbitrary home files are
never scanned or copied.
EOF
}

while (($#)); do
    case "$1" in
        --repo) ROOT=${2:?--repo needs a path}; shift ;;
        --dry-run) DRY_RUN=1 ;;
        --no-push) PUSH=0 ;;
        -m|--message) MESSAGE=${2:?--message needs text}; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

if [[ -z "$ROOT" && -n "${RICE_REPO_DIR:-}" ]]; then ROOT=$RICE_REPO_DIR; fi
if [[ -z "$ROOT" ]] && git rev-parse --show-toplevel >/dev/null 2>&1; then
    ROOT=$(git rev-parse --show-toplevel)
fi
if [[ -z "$ROOT" && -d "$HOME/Ricelin/ricelin-dotfiles/.git" ]]; then
    ROOT=$HOME/Ricelin/ricelin-dotfiles
fi
ROOT=$(CDPATH= cd -- "${ROOT:-.}" && pwd)
git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Run inside the dotfiles repo or set RICE_REPO_DIR/--repo." >&2
    exit 1
}

sync_tree() {
    local source=$1 target=$2
    mkdir -p "$target"
    rsync -a --delete --exclude='__pycache__/' --exclude='*.pyc' --exclude='*.bak' "$source/" "$target/"
}

sync_optional_tree() {
    local source=$1 target=$2
    if [[ -d "$source" ]]; then sync_tree "$source" "$target"; fi
}

sync_tree "$HOME/.config/hypr" "$ROOT/dotfiles/.config/hypr"
sync_tree "$HOME/.config/quickshell" "$ROOT/dotfiles/.config/quickshell"
sync_optional_tree "$HOME/.config/ricelin" "$ROOT/dotfiles/.config/ricelin"
sync_optional_tree "$HOME/.config/ghostty" "$ROOT/dotfiles/.config/ghostty"
sync_optional_tree "$HOME/.config/kitty" "$ROOT/dotfiles/.config/kitty"
sync_optional_tree "$HOME/.config/fish" "$ROOT/dotfiles/.config/fish"
rm -f "$ROOT/dotfiles/.config/fish/fish_variables"
sync_optional_tree "$HOME/.config/fastfetch" "$ROOT/dotfiles/.config/fastfetch"
sync_optional_tree "$HOME/.config/gtk-3.0" "$ROOT/dotfiles/.config/gtk-3.0"
sync_optional_tree "$HOME/.config/gtk-4.0" "$ROOT/dotfiles/.config/gtk-4.0"
sync_optional_tree "$HOME/.config/Thunar" "$ROOT/dotfiles/.config/Thunar"
sync_optional_tree "$HOME/.config/vesktop/settings" "$ROOT/dotfiles/.config/vesktop/settings"

mkdir -p "$ROOT/dotfiles/.local/bin"
for helper in ricelin-personal-palette.py steam wallpaper-rgb-sync.sh; do
    if [[ -f "$HOME/.local/bin/$helper" ]]; then
        cp "$HOME/.local/bin/$helper" "$ROOT/dotfiles/.local/bin/$helper"
    fi
done

# Spicetify has account/session state outside these paths. Keep the themes,
# Marketplace app, and config only.
if [[ -d "$HOME/.config/spicetify/Themes" ]]; then
    mkdir -p "$ROOT/dotfiles/.config/spicetify/Themes"
    rsync -a --delete --exclude='screenshots/' "$HOME/.config/spicetify/Themes/" "$ROOT/dotfiles/.config/spicetify/Themes/"
fi
sync_optional_tree "$HOME/.config/spicetify/CustomApps/marketplace" "$ROOT/dotfiles/.config/spicetify/CustomApps/marketplace"
if [[ -f "$HOME/.config/spicetify/config-xpui.ini" ]]; then
    cp "$HOME/.config/spicetify/config-xpui.ini" "$ROOT/dotfiles/.config/spicetify/config-xpui.ini"
fi

# Capture only user-authored unit files, never enablement symlinks or account
# services owned by the host application.
if [[ -d "$HOME/.config/systemd/user" ]]; then
    mkdir -p "$ROOT/dotfiles/.config/systemd/user"
    rsync -a --delete --exclude='default.target.wants/' --exclude='graphical-session.target.wants/' --exclude='*.ricelin-managed' \
        "$HOME/.config/systemd/user/" "$ROOT/dotfiles/.config/systemd/user/"
fi
find "$ROOT/dotfiles/.config/systemd/user" -type f \( -name 'chatgpt.service' -o -name 'codex-*.service' -o -name 'ricelin-personal-addon.*' \) -delete 2>/dev/null || true
find "$ROOT/dotfiles/.config/systemd/user" -type f -path '*/default.target.wants/*' -delete 2>/dev/null || true
find "$ROOT/dotfiles/.config/systemd/user" -type f -path '*/graphical-session.target.wants/*' -delete 2>/dev/null || true

mkdir -p "$ROOT/packages" "$ROOT/system"
pacman -Qqe 2>/dev/null | sort > "$ROOT/packages/pacman-explicit.txt" || true
pacman -Qqm 2>/dev/null | sort > "$ROOT/packages/aur.txt" || true
if command -v flatpak >/dev/null; then flatpak list --app --columns=application,branch | sort > "$ROOT/system/flatpak-apps.txt"; else : > "$ROOT/system/flatpak-apps.txt"; fi
if command -v pipx >/dev/null; then pipx list --short 2>/dev/null | sort > "$ROOT/system/pipx-apps.txt" || :; else : > "$ROOT/system/pipx-apps.txt"; fi
localectl status > "$ROOT/system/localectl-status.txt" 2>/dev/null || true
for mime in text/html x-scheme-handler/http x-scheme-handler/https inode/directory audio/mpeg video/mp4 image/png application/pdf; do
    printf '%s\t%s\n' "$mime" "$(xdg-mime query default "$mime" 2>/dev/null || true)"
done > "$ROOT/system/default-apps.tsv"
systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{print $1}' | sort > "$ROOT/system/enabled-user-services.txt" || true

if rg -n -i '(gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|BEGIN [A-Z ]*PRIVATE KEY|aws_secret_access_key|api[_-]?key[[:space:]]*[:=])' "$ROOT" \
    --glob '!packages/*.txt' --glob '!docs/*.md' --glob '!**/scripts/rice-update'; then
    echo "Potential credential material found; refusing to commit." >&2
    exit 1
fi

git -C "$ROOT" add -A
if git -C "$ROOT" diff --cached --quiet; then
    echo "No rice changes detected."
    exit 0
fi

git -C "$ROOT" diff --cached --stat
if ((DRY_RUN)); then
    echo "Dry run: staged changes were not committed or pushed."
    git -C "$ROOT" reset >/dev/null
    exit 0
fi

if [[ -z "$MESSAGE" ]]; then
    MESSAGE="Update rice $(date +%Y-%m-%d-%H%M)"
fi
git -C "$ROOT" commit -m "$MESSAGE"
if ((PUSH)); then
    git -C "$ROOT" push
else
    echo "Committed locally; push skipped (--no-push)."
fi
