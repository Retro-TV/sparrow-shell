[Unit]
Description=Sparrow Shell virtual keyboard input daemon
Documentation=https://github.com/ReimuNotMoe/ydotool
Requires=user-runtime-dir@__UID__.service
After=user-runtime-dir@__UID__.service
BindsTo=user-runtime-dir@__UID__.service

[Service]
Type=simple
ExecStart=/usr/bin/ydotoold --socket-path=/run/user/__UID__/.ydotool_socket --socket-perm=0600 --socket-own=__UID__:__GID__
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
