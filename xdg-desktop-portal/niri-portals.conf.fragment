# Merge Sparrow's targeted preferences into the user's existing
# $XDG_CONFIG_HOME/xdg-desktop-portal/niri-portals.conf.
# This is intentionally not a complete portal config. Preserve any explicit
# user choice for ScreenCast, RemoteDesktop, Screenshot, Secret, and all other
# interfaces. Installer adds ScreenCast=gnome only when no route exists.
[preferred]
org.freedesktop.impl.portal.FileChooser=gtk;
org.freedesktop.impl.portal.ScreenCast=gnome;
